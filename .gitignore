# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local-only planning/design docs
/PLAN.md
/DESIGN.md
/CLAUDE.md

# typescript
*.tsbuildinfo
next-env.d.ts

# resumes and other sample documents used to exercise the uploader locally.
# Never commit a real CV - it is someone's name, address, phone and email, and
# a public repo is forever.
*.pdf
*.docx
*.doc
*.rtf
*.odt
/samples/

# test suite - runs locally, not published. `npm test` still works for whoever
# has these files; a fresh clone simply has nothing to run.
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__fixtures__/
**/__tests__/
**/__mocks__/
vitest.config.mts
vitest.config.ts

# dev-only ATS debug route. Ignored because it imports lib/ats/__fixtures__,
# which is not published - publishing the route without them would break the
# build on a fresh clone. It is a local iteration tool, not a product surface.
/app/api/ats/debug/

# credentials and keys. `.env*` and `*.pem` are covered above; these are the
# rest of the shapes that must never reach a public remote.
*.key
*.p12
*.pfx
*.pkcs12
*.crt
id_rsa*
*.mobileprovision
secrets.json
credentials.json
service-account*.json

# editor and OS local state
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# agent / local tooling state
.claude/
.cursor/
.aider*

# local scratch
/tmp/
/scratch/
*.local
